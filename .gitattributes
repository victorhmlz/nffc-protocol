# Normalize line endings: LF in the repository, native on checkout is disabled —
# everyone gets LF so Prettier (`endOfLine: "lf"`) and CI agree regardless of OS.
* text=auto eol=lf

# Binary / generated — never touch.
pnpm-lock.yaml -text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
