# NFFC Protocol — environment template.
# Copy to `.env.local` for local development. Never commit real values.
#
# Validation and resolution: infra/env.ts (zod). `staging` / `production` require
# DATABASE_URL, REDIS_URL, and RPC_4663_URLS; `development` / `test` tolerate
# their absence (the relevant client throws only when actually used).

# ── Environment ──────────────────────────────────────────────────────────────
# development | test | staging | production   (default: development)
APP_ENV=development

# debug | info | warn | error   (default: debug in dev, warn in test, info in staging/prod)
# LOG_LEVEL=debug

# ── RPC — Robinhood Chain (Chain ID 4663) ────────────────────────────────────
# Comma-separated. First is primary, the rest are automatic failover.
# The abstraction is provider-agnostic — supply as many endpoints as you have.
# RPC_4663_URLS=https://rpc-1.example,https://rpc-2.example

# ── PostgreSQL (index / cache — never the source of truth for ownership) ──────
# DATABASE_URL=postgres://user:pass@localhost:5432/nffc
# DATABASE_MAX_CONNECTIONS=10

# ── Redis (cache / locks) ────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ── Wallet (TASK-16) — self-custody only, read by the browser (NEXT_PUBLIC_*) ─
# The public RPC(s) wagmi's client reads through once a wallet is connected.
# Comma-separated, same shape as RPC_4663_URLS but client-safe (never secrets).
# NEXT_PUBLIC_RPC_4663_URLS=https://rpc-1.example,https://rpc-2.example
#
# WalletConnect Cloud project id (https://cloud.walletconnect.com). Without it,
# generic EVM wallets still connect via the injected (browser-extension)
# connector; only the WalletConnect (QR / mobile) connector is omitted.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Provider sync workers (TASK-06 Robinhood, TASK-07 crypto) ─────────────────
# Not operational until the registries + adapters are deployed (TASK-31). With
# these unset a worker logs "not configured" and exits.
# CONTRACT_REPRESENTATION_REGISTRY=0x...       # shared by both workers
#
# CONTRACT_ROBINHOOD_ADAPTER=0x...
# ROBINHOOD_SYNC_PRIVATE_KEY=0x...             # holds SYNC_ROLE on RobinhoodAdapter
# ROBINHOOD_TOKENS_FILE=config/robinhood/stock-tokens.json      # default
#
# CONTRACT_CRYPTO_ADAPTER=0x...
# CRYPTO_SYNC_PRIVATE_KEY=0x...                # holds SYNC_ROLE on CryptoAdapter
# CRYPTO_TOKENS_FILE=config/crypto/native-tokens.json           # default

# Added by later TASKS:
#   TASK-22  — oracle / Chainlink feed configuration (if any beyond on-chain reads)
#   TASK-31+ — admin / multisig addresses
