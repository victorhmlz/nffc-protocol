# NFFC Protocol — environment template.
# Copy to `.env.local` for local development. Never commit real values.
#
# Validation and resolution: infra/env.ts (zod). `staging` / `production` require
# DATABASE_URL, REDIS_URL, and RPC_4663_URLS; `development` / `test` tolerate
# their absence (the relevant client throws only when actually used).

# ── Environment ──────────────────────────────────────────────────────────────
# development | test | staging | production   (default: development)
APP_ENV=development

# debug | info | warn | error   (default: debug in dev, warn in test, info in staging/prod)
# LOG_LEVEL=debug

# ── RPC — Robinhood Chain (Chain ID 4663) ────────────────────────────────────
# Comma-separated. First is primary, the rest are automatic failover.
# The abstraction is provider-agnostic — supply as many endpoints as you have.
# RPC_4663_URLS=https://rpc-1.example,https://rpc-2.example

# ── PostgreSQL (index / cache — never the source of truth for ownership) ──────
# DATABASE_URL=postgres://user:pass@localhost:5432/nffc
# DATABASE_MAX_CONNECTIONS=10

# ── Redis (cache / locks) ────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ── Robinhood sync worker (TASK-06) ──────────────────────────────────────────
# Not operational until the registries + adapter are deployed (TASK-31). With
# these unset the worker logs "not configured" and exits.
# CONTRACT_REPRESENTATION_REGISTRY=0x...
# CONTRACT_ROBINHOOD_ADAPTER=0x...
# ROBINHOOD_SYNC_PRIVATE_KEY=0x...            # holds SYNC_ROLE on the adapter
# ROBINHOOD_TOKENS_FILE=config/robinhood/stock-tokens.json   # default

# Added by later TASKS:
#   TASK-22  — oracle / Chainlink feed configuration (if any beyond on-chain reads)
#   TASK-31+ — admin / multisig addresses
